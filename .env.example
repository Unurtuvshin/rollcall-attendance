# Copy to .env. Python 3.11+; no package installation required.
HOST=127.0.0.1
PORT=3000
DEMO_MODE=1
# Required with DEMO_MODE=0 (at least 32 random characters)
INTEGRATION_TOKEN=
# HTTPS deployment: SECURE_COOKIE=1
SECURE_COOKIE=0
# SMTP: absent in demo mode -> local mailbox only. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=attendance@example.edu
SMTP_STARTTLS=1
# Initial administrator (used only for a new database)
ADMIN_ID=teacher
ADMIN_NAME=山田 太郎
ADMIN_PASSWORD=
